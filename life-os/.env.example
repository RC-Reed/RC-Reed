# Copy to .env and fill in. Never commit the result.
#
# Generate the two keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          # SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # VAULT_KEY

# --- database --------------------------------------------------------------
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeos

# --- security --------------------------------------------------------------
# Signs session tokens. Changing it logs everyone out.
LIFEOS_SECRET_KEY=change-me

# Encrypts connector credentials at rest. LOSING THIS MEANS RE-ENTERING EVERY
# CREDENTIAL — back it up somewhere other than this machine. Leave blank and one
# is generated into api/data/vault.key on first boot.
LIFEOS_VAULT_KEY=

# Authenticates device pushes (Apple Health). Blank generates one on first boot;
# read it back from the Connections page.
LIFEOS_INGEST_TOKEN=

# --- behaviour -------------------------------------------------------------
LIFEOS_PORT=8080
LIFEOS_SCHEDULER_ENABLED=true
LIFEOS_SYNC_INTERVAL_MINUTES=60
LIFEOS_CORS_ORIGINS=http://localhost:8080
